<Window x:Class="LocalChat.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LocalChat · 本地收件箱" Icon="Assets/localchat.ico" Width="1080" Height="800" MinWidth="480" MinHeight="600" FontFamily="Microsoft YaHei UI" FontSize="14" Background="#F4F6F3" Foreground="#263D32" AllowDrop="True" PreviewDragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing" SizeChanged="OnWindowSizeChanged">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SearchColumn" Width="0"/></Grid.ColumnDefinitions>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="100"/><RowDefinition Height="8"/><RowDefinition x:Name="ComposerRow" Height="220" MinHeight="160"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Visibility="{Binding Visibility, ElementName=ReturnLatestButton}" BorderBrush="#E0E7DF" BorderThickness="0,0,0,1" Background="#FAFCF9" Padding="16,3">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="ReturnLatestButton" Content="返回最新" Height="28" FontSize="11" Padding="8,3" Margin="0,0,8,0" Visibility="Collapsed" Click="OnLatest"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <ListBox x:Name="MessagesList" Background="Transparent" BorderThickness="0" Padding="22,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch" SelectionMode="Single">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,15"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding DateLabel}" Visibility="{Binding DateVisibility}" HorizontalAlignment="Center" Foreground="#8E9B91" FontSize="11" Margin="0,10,0,20"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" MaxWidth="610">
                  <TextBlock Text="{Binding Timestamp}" Foreground="#8C9A90" FontSize="10" HorizontalAlignment="Right" Margin="0,0,3,5"/>
                  <Border x:Name="MessageBubble" HorizontalAlignment="Right" MaxWidth="610" Background="#E1EFDF" BorderBrush="#D2E3D0" BorderThickness="1" CornerRadius="12,3,12,12" Padding="14,11">
                    <Border.ContextMenu>
                      <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="复制文字" Visibility="{Binding TextActionsVisibility}" Click="OnCopyMessage"/>
                        <MenuItem Header="编辑" Visibility="{Binding TextActionsVisibility}" Click="OnEditMessage"/>
                        <MenuItem Header="删除" Click="OnDeleteMessage"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel>
                      <TextBlock Text="{Binding Text}" Visibility="{Binding TextVisibility}" TextWrapping="Wrap" LineHeight="23"/>
                      <ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="#FBFDF9" CornerRadius="8" Padding="10" Margin="0,5,0,3" MinWidth="280">
                          <StackPanel>
                            <Image Source="{Binding Thumbnail}" Visibility="{Binding ImageVisibility}" MaxWidth="390" MaxHeight="260" Stretch="Uniform" HorizontalAlignment="Left" MouseLeftButtonUp="OnPreview" Cursor="Hand" Margin="0,0,0,8"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" FontSize="25" Foreground="#5E8067"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding OriginalName}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="#8C9A90" FontSize="11" Margin="0,4,0,0"/></StackPanel></Grid>
                            <WrapPanel Margin="0,7,0,0"><Button Content="打开" Padding="8,4" FontSize="11" Click="OnOpenAttachment"/><Button Content="保存" Padding="8,4" FontSize="11" Click="OnSaveAttachment"/><Button Content="另存为" Padding="8,4" FontSize="11" Click="OnSaveAsAttachment"/><Button Content="定位" Padding="8,4" FontSize="11" Click="OnLocateAttachment"/></WrapPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <Border x:Name="MessageAvatar" Grid.Column="2" VerticalAlignment="Top" Background="#39745C" CornerRadius="6" Height="32" Width="32" Margin="8,21,0,0"><TextBlock Text="我" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              </Grid>
            </StackPanel>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="LoadOlderButton" Content="↑ 加载更早消息" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="11" Padding="12,4" Click="OnLoadOlder"/>
      </Grid>
      <GridSplitter x:Name="ComposerSplitter" Grid.Row="2" Height="8" Margin="22,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeNS" ToolTip="上下拖动，调整输入框高度" AutomationProperties.Name="调整输入框高度"><GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Grid Background="{TemplateBinding Background}"><Border Width="44" Height="3" CornerRadius="1.5" Background="#CEDACF" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></ControlTemplate></GridSplitter.Template></GridSplitter>
      <Border Grid.Row="3" Margin="22,0,22,12" Background="White" BorderBrush="#DCE5DC" BorderThickness="1" CornerRadius="12" Padding="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ListBox x:Name="PendingList" MaxHeight="50" BorderThickness="0" Background="#F6F9F4" Visibility="Collapsed"><ListBox.ItemTemplate><DataTemplate><DockPanel><Button Content="移除" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="10" Padding="6,2" Click="OnRemovePending"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBox x:Name="Composer" Grid.Row="1" AutomationProperties.Name="消息输入框" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="White" Padding="2,2,2,8" PreviewKeyDown="OnComposerKeyDown" TextChanged="OnComposerChanged"/>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="ComposerTools" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="SettingsIconButton" Width="28" Height="28" Padding="5" Margin="0" Background="Transparent" BorderBrush="Transparent" ToolTip="设置" AutomationProperties.Name="设置" Click="OnSettings">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#456551" IsHitTestVisible="False"/>
              </Button>
              <Button x:Name="SearchIconButton" Width="28" Height="28" Padding="5" Margin="6,0,0,0" Background="Transparent" BorderBrush="Transparent" ToolTip="查找记录" AutomationProperties.Name="查找记录" Click="OnToggleSearch">
                <Canvas Width="16" Height="16" IsHitTestVisible="False">
                  <Ellipse Width="10" Height="10" Canvas.Left="1" Canvas.Top="1" Stroke="#456551" StrokeThickness="1.7"/>
                  <Line X1="10" Y1="10" X2="15" Y2="15" Stroke="#456551" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Button>
              <Button x:Name="AddFileButton" Width="28" Height="28" Padding="5" Margin="6,0,0,0" Background="Transparent" BorderBrush="Transparent" ToolTip="添加文件" AutomationProperties.Name="添加文件" Click="OnAddFiles">
                <Path Width="16" Height="16" Data="M1,5 L1,3 Q1,2 2,2 L6,2 L8,4 L14,4 Q15,4 15,5 L15,13 Q15,14 14,14 L2,14 Q1,14 1,13 Z M1,6 L15,6" Stroke="#456551" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
              </Button>
            </StackPanel>
            <TextBlock x:Name="KeyboardHint" Grid.Column="1" Text="Enter 发送 · Shift+Enter 换行" Margin="12,0,8,0" VerticalAlignment="Center" FontSize="10" Foreground="#99A59B" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="SendButton" Grid.Column="2" Content="发送  ↵" Background="#39745C" Foreground="White" Padding="22,8" Click="OnSend" IsEnabled="False"/>
          </Grid>
        </Grid>
      </Border>
      <TextBlock x:Name="Status" Grid.Row="4" Text="" Foreground="#7D8E81" FontSize="11" Margin="26,0,22,10" TextTrimming="CharacterEllipsis">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
    </Grid>
    <Border x:Name="SearchPanel" Grid.Column="1" Visibility="Collapsed" Background="#FBFCF9" BorderBrush="#DCE5DF" BorderThickness="1,0,0,0" Padding="16">
      <DockPanel><StackPanel DockPanel.Dock="Top">
        <Grid Margin="0,0,0,20">
          <TextBlock Text="查找记录" FontSize="20" FontWeight="SemiBold" Margin="0,10,42,0"/>
          <Button x:Name="CloseSearchButton" Content="×" AutomationProperties.Name="关闭搜索框" ToolTip="关闭搜索" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Padding="0" Margin="0" FontSize="24" Background="Transparent" BorderBrush="Transparent" Click="OnCloseSearch"/>
        </Grid>
        <TextBlock Text="文字 / 文件名" FontSize="12" Margin="0,0,0,5"/><TextBox x:Name="SearchText" AutomationProperties.Name="搜索文字或文件名" KeyDown="OnSearchKeyDown"/>
        <TextBlock Text="日期范围（包含结束日）" FontSize="12" Margin="0,15,0,5"/><DatePicker x:Name="FromDate"/><DatePicker x:Name="ToDate" Margin="0,6,0,0"/>
        <ComboBox x:Name="KindFilter" SelectedIndex="0" Margin="0,12,0,8" Padding="6"><ComboBoxItem Content="全部内容" Tag="all"/><ComboBoxItem Content="文字" Tag="text"/><ComboBoxItem Content="图片" Tag="image"/><ComboBoxItem Content="视频" Tag="video"/><ComboBoxItem Content="其他文件" Tag="file"/></ComboBox>
        <WrapPanel><Button Content="搜索" Background="#39745C" Foreground="White" Click="OnSearch"/><Button Content="重置" Click="OnResetSearch"/></WrapPanel>
        <TextBlock x:Name="SearchCount" FontSize="11" Foreground="#8A998E" Margin="0,12,0,9"/>
      </StackPanel>
      <Button x:Name="MoreResultsButton" DockPanel.Dock="Bottom" Content="更多结果" Visibility="Collapsed" Click="OnMoreResults"/>
      <ListBox x:Name="SearchResults" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnSearchSelection"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E0E7DF" BorderThickness="0,0,0,1" Padding="3,12" Width="230"><StackPanel><TextBlock Text="{Binding Timestamp}" FontSize="10" Foreground="#8A998E"/><TextBlock Text="{Binding Text}" MaxHeight="60" TextWrapping="Wrap" Margin="0,5,0,0"/><ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding OriginalName}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#5E8067"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      </DockPanel>
    </Border>
  </Grid>
</Window>


